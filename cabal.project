-- Generated by util/recabal/gen.py from util/recabal/manifest.json; do not
-- edit by hand (CI regenerates and diffs).  Machine-local settings go in
-- cabal.project.local, which is ignored by git.
packages:
  .
  components/setup
  components/htcl
  components/waveforms
  components/stp
  components/yices
  components/common
  components/sat
  components/parse
  components/package
  components/scheduled
  components/typecheck
  components/legacy-ba
  components/bluesim
  components/verilog
  components/schedule
  components/elab
  components/driver

-- Parallel compilation requires deterministic object generation. On older
-- supported compilers, serialize both package and module compilation.
optimization: 2
if impl(ghc >= 9.14.1)
  jobs: $ncpus
  semaphore: True
  program-options
    ghc-options: -j -fobject-determinism
else
  jobs: 1
  semaphore: False
  program-options
    ghc-options: -j1

package bsc-setup
  optimization: 0
