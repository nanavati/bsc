--- a/SetupHooks.hs
+++ b/SetupHooks.hs
@@ -19,6 +19,7 @@ import Distribution.Simple.SetupHooks
 import Distribution.Types.BuildInfo (targetBuildDepends)
 import Distribution.Types.Component (componentBuildInfo)
