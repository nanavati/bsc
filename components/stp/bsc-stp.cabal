cabal-version: 3.14

-- Generated by util/recabal/gen.py from util/recabal/manifest.json; do not
-- edit by hand (CI regenerates and diffs).  The module sources next to this
-- file are symlinks into src/ (doc/compiler-components.md).
name: bsc-stp
version: 2026.1
synopsis: Bluespec Compiler: the STP solver binding; the hooks build the vendored STP and link it. Independent of the compiler.
license: BSD-3-Clause
build-type: Hooks
tested-with: GHC == 9.14.1

extra-source-files:
  ../../platform.mk
  ../../platform.sh
  ../../src/vendor/stp/Makefile
  ../../src/vendor/stp/src/LICENSE/AUTHORS
  ../../src/vendor/stp/src/LICENSE/LICENSE
  ../../src/vendor/stp/src/LICENSE/LICENSE_COMPONENTS
  ../../src/vendor/stp/src/sat/LICENSE
  ../../src/vendor/stp/src/**/*.c
  ../../src/vendor/stp/src/**/*.cc
  ../../src/vendor/stp/src/**/*.cpp
  ../../src/vendor/stp/src/**/*.h
  ../../src/vendor/stp/src/**/*.hpp
  ../../src/vendor/stp/src/**/*.inc
  ../../src/vendor/stp/src/**/*.lex
  ../../src/vendor/stp/src/**/*.mk
  ../../src/vendor/stp/src/**/*.pl
  ../../src/vendor/stp/src/**/*.sh
  ../../src/vendor/stp/src/**/*.txt
  ../../src/vendor/stp/src/**/*.y
  ../../src/vendor/stp/src/**/Makefile
  ../../src/vendor/stp/src/AST/ASTKind.kinds
  ../../src/vendor/stp/src/Makefile.common
  ../../src/vendor/stp/src_stub/**/*.c
  ../../src/vendor/stp/src_stub/**/*.h
  ../../src/vendor/stp/src_stub/**/Makefile

flag stp-stub
  description: Build the vendored STP stub (Make: STP_STUB=1).
  default: False
  manual: True

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    bsc-setup,

library
  hs-source-dirs: .
  build-depends:
    -- The hook generates Warmup from the exposed modules of every package
    -- named here, so hidden boot packages such as ghc-bignum
    -- and ghc-internal have to be named too.
    array        >=0.5.8.0,
    base         >=4.18.3.0,
    ghc-bignum   >=1.3,
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    deepseq      >=1.4.8.1,
    directory    >=1.3.8.5,
    filepath     >=1.4.301.0,
    integer-gmp  >=1.1,
    mtl          >=2.3.1,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.19.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2,
    time         >=1.12.2,
    unix         >=2.8.6.0,
  if impl(ghc >= 9.10)
    build-depends: ghc-internal
  default-language: GHC2021
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
  if os(osx)
    extra-libraries: c++
  else
    extra-libraries: stdc++
  exposed-modules:
    STP
    STPFFI
  other-modules:
    Warmup
  autogen-modules:
    Warmup,
