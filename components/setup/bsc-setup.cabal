cabal-version: 3.14

name: bsc-setup
version: 2026.1
synopsis: Setup hooks shared by the bsc component packages
description:
  Shared compiler-version checks, component-local Warmup and version generators,
  plus native build configuration owned by the solver and Tcl binding packages.
license: BSD-3-Clause
build-type: Simple
tested-with: GHC == 9.14.1

library
  hs-source-dirs: .
  exposed-modules: BscSetupHooks
  build-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    directory,
    filepath,
    process,
  default-language: GHC2021
  -- Static-pointer rule closures must remain linkable from setup executables.
  ghc-options: -O0
  if impl(ghc >= 9.14.1)
    ghc-options: -fobject-determinism
