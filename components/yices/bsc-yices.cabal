cabal-version: 3.14

-- Generated by util/recabal/gen.py from util/recabal/manifest.json; do not
-- edit by hand (CI regenerates and diffs).  The module sources next to this
-- file are symlinks into src/ (doc/compiler-components.md).
name: bsc-yices
version: 2026.1
synopsis: Bluespec Compiler: the Yices solver binding; the hooks build the vendored Yices and link it. Independent of the compiler.
license: BSD-3-Clause
build-type: Hooks
tested-with: GHC == 9.14.1

extra-source-files:
  ../../platform.mk
  ../../platform.sh
  ../../src/vendor/yices/Makefile
  ../../src/vendor/yices/v2.6/Makefile
  ../../src/vendor/yices/v2.6/stub/**/*.c
  ../../src/vendor/yices/v2.6/stub/**/Makefile
  ../../src/vendor/yices/v2.6/yices2/LICENSE.txt
  ../../src/vendor/yices/v2.6/yices2/Makefile
  ../../src/vendor/yices/v2.6/yices2/Makefile.build
  ../../src/vendor/yices/v2.6/yices2/autoconf/alignment
  ../../src/vendor/yices/v2.6/yices2/autoconf/check_assumptions
  ../../src/vendor/yices/v2.6/yices2/autoconf/config.guess
  ../../src/vendor/yices/v2.6/yices2/autoconf/os
  ../../src/vendor/yices/v2.6/yices2/autoconf/user
  ../../src/vendor/yices/v2.6/yices2/config.guess
  ../../src/vendor/yices/v2.6/yices2/config.sub
  ../../src/vendor/yices/v2.6/yices2/configure.ac
  ../../src/vendor/yices/v2.6/yices2/gmaketest
  ../../src/vendor/yices/v2.6/yices2/install-sh
  ../../src/vendor/yices/v2.6/yices2/make.include.in
  ../../src/vendor/yices/v2.6/yices2/scripts/**/*.sh
  ../../src/vendor/yices/v2.6/yices2/scripts/**/*.txt
  ../../src/vendor/yices/v2.6/yices2/src/**/*.c
  ../../src/vendor/yices/v2.6/yices2/src/**/*.cxxx
  ../../src/vendor/yices/v2.6/yices2/src/**/*.h
  ../../src/vendor/yices/v2.6/yices2/src/**/*.hxxx
  ../../src/vendor/yices/v2.6/yices2/src/**/*.txt
  ../../src/vendor/yices/v2.6/yices2/src/**/Makefile
  ../../src/vendor/yices/v2.6/yices2/utils/make_source_version
  ../../src/vendor/yices/v2.6/yices2/utils/**/*.c
  ../../src/vendor/yices/v2.6/yices2/utils/**/*.h
  ../../src/vendor/yices/v2.6/yices2/utils/**/*.py
  ../../src/vendor/yices/v2.6/yices2/utils/**/*.txt

flag yices-stub
  description: Build the vendored Yices stub (Make: YICES_STUB=1).
  default: False
  manual: True

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    bsc-setup,

library
  hs-source-dirs: .
  build-depends:
    -- The hook generates Warmup from the exposed modules of every package
    -- named here, so hidden boot packages such as ghc-bignum
    -- and ghc-internal have to be named too.
    array        >=0.5.8.0,
    base         >=4.18.3.0,
    ghc-bignum   >=1.3,
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    deepseq      >=1.4.8.1,
    directory    >=1.3.8.5,
    filepath     >=1.4.301.0,
    integer-gmp  >=1.1,
    mtl          >=2.3.1,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.19.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2,
    time         >=1.12.2,
    unix         >=2.8.6.0,
  if impl(ghc >= 9.10)
    build-depends: ghc-internal
  default-language: GHC2021
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
  exposed-modules:
    Yices
    YicesFFI
  other-modules:
    Warmup
  autogen-modules:
    Warmup,
