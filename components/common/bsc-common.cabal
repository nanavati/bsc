cabal-version: 3.14

-- Generated by util/recabal/gen.py from util/recabal/manifest.json; do not
-- edit by hand (CI regenerates and diffs).  The module sources next to this
-- file are symlinks into src/ (doc/compiler-components.md).
name: bsc-common
version: 2026.1
synopsis: Bluespec Compiler: shared utilities, compiler representations, neutral options and diagnostics
license: BSD-3-Clause
build-type: Hooks
tested-with: GHC == 9.14.1

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    bsc-setup,

library
  hs-source-dirs: .
  build-depends:
    -- The hook generates Warmup from the exposed modules of every package
    -- named here, so hidden boot packages such as ghc-bignum
    -- and ghc-internal have to be named too.
    array        >=0.5.8.0,
    base         >=4.18.3.0,
    ghc-bignum   >=1.3,
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    deepseq      >=1.4.8.1,
    directory    >=1.3.8.5,
    filepath     >=1.4.301.0,
    integer-gmp  >=1.1,
    mtl          >=2.3.1,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.19.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2,
    time         >=1.12.2,
    unix         >=2.8.6.0,
  if impl(ghc >= 9.10)
    build-depends: ghc-internal
  default-language: GHC2021
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
  exposed-modules:
    ACaseUtils
    ACheck
    AModule
    ASyntax
    ASyntaxUtil
    AUses
    Assump
    BDD
    Backend
    Bag
    Balanced
    BinData
    BinForeignFunctions
    BoolExp
    BuildSystem
    CCSyntax
    CFreeVars
    CSyntax
    CSyntaxTypes
    CSyntaxUtil
    CType
    CVPrint
    Changed
    Classic
    CompilerVersion
    ConTagInfo
    CondTree
    DynamicMap
    Error
    ErrorMonad
    ErrorUtil
    Eval
    FStringCompat
    FileIOUtil
    FileNameUtil
    Fixity
    FlagTypes
    ForeignFunctions
    GHCPretty
    GenWrapUtils
    GlobPattern
    GraphMap
    GraphUtil
    GraphWrapper
    IOMutVar
    IOUtil
    IStateLoc
    ISyntax
    ISyntaxSubst
    ISyntaxUtil
    ISyntaxXRef
    IType
    Id
    IdPrint
    InstNodes
    IntLit
    IntegerUtil
    Lex
    ListMap
    ListUtil
    Literal
    Log2
    MVarStrict
    PFPrint
    PPrint
    PVPrint
    Params
