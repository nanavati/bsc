package SplitRev where

import Vector
import LaneDefs

-- A second, conflicting ORPHAN instance for the same head as SplitFwd's
-- (also warned T0127 here, and nowhere else).
--
-- Emits the IDENTICAL port-name set (_0.._3, same widths) but with the
-- opposite lane mapping: port _0 carries the highest lane ("lane 0 is the
-- MSB lane, per the interconnect spec").  A module generated in this cone
-- and a module generated in SplitFwd's cone have indistinguishable pinouts
-- and opposite meanings.
instance SplitPorts QBus (Port (Bit 8), Port (Bit 8), Port (Bit 8), Port (Bit 8)) where
    splitPorts v = (Port (select v (3 :: Integer)), Port (select v (2 :: Integer)),
                    Port (select v (1 :: Integer)), Port (select v (0 :: Integer)))
    unsplitPorts (Port a, Port b, Port c, Port d) =
        update (update (update (update newVector (3 :: Integer) a)
                               (2 :: Integer) b)
                       (1 :: Integer) c)
               (0 :: Integer) d
    portNames _ base =
        Cons (base +++ "_0") (Cons (base +++ "_1")
            (Cons (base +++ "_2") (Cons (base +++ "_3") Nil)))
