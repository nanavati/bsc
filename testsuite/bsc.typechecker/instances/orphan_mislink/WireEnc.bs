package WireEnc where

import MsgDefs

-- ORPHAN instance: the class (Bits) and every type in the instance head
-- (Msg, Hdr) are defined in other packages, so this compile gets warning
-- T0127 -- and it is the only compile in the whole test that gets any
-- diagnostic at all.
--
-- This instance is also a legal *overlap* with the derived generic instance
-- Bits (Msg t) _ from MsgDefs: it is strictly more specific, so the pair is
-- ordered and the duplicate-instance check (T0099) can never fire for it.
-- Any package that imports WireEnc resolves Bits (Msg Hdr) to this layout;
-- any package that does not, silently resolves to the derived layout.
--
-- Same width (33 bits) as the derived layout, different field placement:
-- valid is moved to the MSB ("per the wire spec").
instance Bits (Msg Hdr) 33 where
    pack m   = pack m.valid ++ pack m.payload
    unpack b = Msg { valid = unpack b[32:32]; payload = unpack b[31:0]; }
