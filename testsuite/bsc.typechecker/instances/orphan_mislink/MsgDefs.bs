package MsgDefs where

-- Shared protocol types, with derived (generic) Bits instances.
--
-- Derived layouts (first field in the most-significant bits):
--   Hdr:      src [31:24] ++ dst [23:16] ++ len [15:0]           (32 bits)
--   Msg t:    payload [msb:1] ++ valid [0]                       (width t + 1)

struct Hdr =
    src :: Bit 8
    dst :: Bit 8
    len :: Bit 16
  deriving (Bits, Eq)

struct Msg t =
    payload :: t
    valid   :: Bool
  deriving (Bits, Eq)

-- A test message used by several of the mislink tests
testMsg :: Msg Hdr
testMsg = Msg { payload = Hdr { src = 0xAA; dst = 0xBB; len = 0xCAFE; }; valid = True; }
