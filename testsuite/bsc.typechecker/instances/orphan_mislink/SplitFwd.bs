package SplitFwd where

import Vector
import LaneDefs

-- ORPHAN instance (SplitPorts is from the Prelude, Vector from the Vector
-- package): warned T0127 here at the definition site, and nowhere else.
--
-- Splits a QBus into four ports named _0.._3, port i carrying lane i
-- (the same convention as the SplitPorts library's vector splitting).
instance SplitPorts QBus (Port (Bit 8), Port (Bit 8), Port (Bit 8), Port (Bit 8)) where
    splitPorts v = (Port (select v (0 :: Integer)), Port (select v (1 :: Integer)),
                    Port (select v (2 :: Integer)), Port (select v (3 :: Integer)))
    unsplitPorts (Port a, Port b, Port c, Port d) =
        update (update (update (update newVector (0 :: Integer) a)
                               (1 :: Integer) b)
                       (2 :: Integer) c)
               (3 :: Integer) d
    portNames _ base =
        Cons (base +++ "_0") (Cons (base +++ "_1")
            (Cons (base +++ "_2") (Cons (base +++ "_3") Nil)))
