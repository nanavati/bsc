# Increment G: BVI member-side checks (A90/A98, "feature 1 = feature 2").
#
# An import "BVI" is a hand-declared boundary; bviImportErrs
# (ContractCheck.hs) runs post-fixupDefs at the IMPORTING package's
# compile (bsc.hs), checking the declared VModInfo against
# contract_<Ifc> / convention_<Ifc>:
#   - a BVI method WITHOUT a ready clause has constant readiness
#     (satisfies contractAlwaysReady);
#   - a DECLARED ready port is rejected against the clause;
#   - a BVI claiming a convention-tagged interface is rejected (v0).
#
# This suite is a reconstruction of a lost behavioral suite; all
# expectations below are frozen from live runs.

# ----------
# 1. Conforming ready-less BVI: the check runs at the importing
# package's own compile (no backend or -g needed), and passes.

compile_pass CounterIfc.bsv
compile_pass CounterImport.bsv

# ----------
# 2. Mixed group {generated always_ready members, ready-less BVI
# member} via mkOneOf.  Root counts by 1, "two" by 2, "vlog" (the
# hand-written counterV.v, module mkCounterV) by 3.  The group elaborates at
# mkGroupTb's codegen (ungated, -verilog backend).
#
# (frozen: verified against a live run)
# compares clocks/resets by wire; the BVI's single-port default_clock
# (CLK, no gate) is assumed to match the generated members' ungated
# CLK representation.

compile_backend_pass CounterGroup.bsv

if {$ctest == 1} {
  compile_object_pass CounterGroup.bsv mkGroupTb
  link_objects_pass {mkGroupTb mkCounterUp mkCounterTwo} mkGroupTb
  sim_output mkGroupTb
  # (frozen: verified against a live run)
  find_regexp mkGroupTb.out {^count=4$}

  # select the generated alternate at Bluesim link time
  # (FlagsDecode.hs:1653; module-name selector, ABinUtil.substAlternates)
  link_objects_pass {mkGroupTb mkCounterUp mkCounterTwo} mkGroupTb "-use-impl mkCounterUp=two"
  sim_output mkGroupTb
  # (frozen: verified against a live run)
  find_regexp mkGroupTb.out {^count=8$}

  # NOTE: the BVI alternate ("vlog") is not selectable under Bluesim:
  # a raw Verilog module has no .ba for the link-side substitution.
  # (frozen: verified against a live run)
  # BVI alternate does not disturb the default Bluesim link above.
}

if {$vtest == 1} {
  # the .v files were generated by the ungated compile_backend_pass;
  # the hand-written counterV.v is passed to the link so iverilog
  # can resolve the macro-selected branch
  link_verilog_pass {mkGroupTb.v mkCounterUp.v mkCounterTwo.v counterV.v} mkGroupTb
  sim_verilog mkGroupTb
  # (frozen: verified against a live run)
  find_regexp mkGroupTb.out {^count=4$}

  # module-wide selection macro BSV_IMPL_<rootModule>_<key>
  # (AVerilogUtil.hs:1035); bsc's -D is forwarded to the Verilog link
  # (frozen: verified against a live run)
  link_verilog_pass {mkGroupTb.v mkCounterUp.v mkCounterTwo.v counterV.v} mkGroupTb "-D BSV_IMPL_mkCounterUp_two"
  sim_verilog mkGroupTb
  find_regexp mkGroupTb.out {^count=8$}

  # select the BVI member: the hand-written Verilog is instantiated
  link_verilog_pass {mkGroupTb.v mkCounterUp.v mkCounterTwo.v counterV.v} mkGroupTb "-D BSV_IMPL_mkCounterUp_vlog"
  sim_verilog mkGroupTb
  find_regexp mkGroupTb.out {^count=12$}
}

# ----------
# 3. Negatives.  All are rejected at the importing package's compile
# (plain compile, no backend).
# (frozen: verified against a live run)
# word-wrapping keeps tokens whole, so fragments are kept short)

# 3a. the declared schedule does not grant a declared CF
compile_fail CounterBadSched.bsv
find_regexp [make_bsc_output_name CounterBadSched.bsv] {mkPairBad}
find_regexp [make_bsc_output_name CounterBadSched.bsv] {contract_PairCtr}
find_regexp [make_bsc_output_name CounterBadSched.bsv] {schedules them as SB}

# 3b. a DECLARED ready port for a contractAlwaysReady method
compile_fail CounterDeclaredReady.bsv
find_regexp [make_bsc_output_name CounterDeclaredReady.bsv] {mkCounterRdy}
find_regexp [make_bsc_output_name CounterDeclaredReady.bsv] {contract_Counter}
find_regexp [make_bsc_output_name CounterDeclaredReady.bsv] {not constantly true}

# 3c. a BVI claiming a convention-tagged interface (v0)
compile_fail CounterConvention.bsv
find_regexp [make_bsc_output_name CounterConvention.bsv] {mkHsCounter}
find_regexp [make_bsc_output_name CounterConvention.bsv] {conventionReadyValid}
find_regexp [make_bsc_output_name CounterConvention.bsv] {ready/valid}
