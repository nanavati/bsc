# Increment F (A97): dotted method paths in contract/convention atoms.
#
# MethodPath ::= ident ("." ident)*
#
# Dotted paths name sub-interface methods; the checker flattens them
# to the underscore-joined boundary rendering (fieldPathName renders
# hierarchy with dots, boundary names with underscores).  Vector-index
# syntax ("fifo[0].m") is outside the grammar and rejected.
#
# This suite is a reconstruction of a lost behavioral suite; all
# expectations below are frozen from live runs.

# ----------
# 1. Hierarchical interface: a synthesized member conforms to a
# contract written with dotted atoms.  The contract check runs at the
# member's own codegen, so compile with a backend even when neither
# simulator is enabled.

compile_backend_pass Hier.bsv

if {$ctest == 1} {
  compile_object_pass Hier.bsv mkHierTb
  link_objects_pass {mkHierTb mkOuterImpl} mkHierTb
  sim_output mkHierTb
  # (frozen: verified against a live run)
  find_regexp mkHierTb.out {^first=42$}
  find_regexp mkHierTb.out {^first=7$}
}

if {$vtest == 1} {
  # mkHierTb.v / mkOuterImpl.v were generated by the ungated
  # compile_backend_pass above
  link_verilog_pass {mkHierTb.v mkOuterImpl.v} mkHierTb
  sim_verilog mkHierTb
  # (frozen: verified against a live run)
  find_regexp mkHierTb.out {^first=42$}
  find_regexp mkHierTb.out {^first=7$}
}

# ----------
# 2. Convention atom with a dotted path: declaredConventions flattens
# convention paths with the same MethodPath grammar
# (readConventions >>= mapM flattenAtomPath in ContractCheck.hs).

compile_backend_pass Conv.bsv

# a malformed convention path gets the grammar error, reported against
# the convention def at the implementation's codegen
compile_fail ConvBadPath.bsv {-verilog}
find_regexp [make_bsc_output_name ConvBadPath.bsv] {convention_ConvBad}
find_regexp [make_bsc_output_name ConvBadPath.bsv] {MethodPath}
# (frozen: verified against a live run)
find_regexp [make_bsc_output_name ConvBadPath.bsv] {`sub\.\.put'}

# ----------
# 3. Group over the hierarchical interface: the group-site inline-root
# protection recognizes the flattened subtree (interface field `fifo'
# appears on the boundary as methods `fifo_*'), and sealing accepts
# the dotted atoms.  Selection is observable: the alternate stores x+1.

compile_backend_pass Group.bsv

if {$ctest == 1} {
  compile_object_pass Group.bsv mkGroupHierTb
  link_objects_pass {mkGroupHierTb mkOuterImpl mkOuterAlt} mkGroupHierTb
  sim_output mkGroupHierTb
  # (frozen: verified against a live run)
  find_regexp mkGroupHierTb.out {^first=42$}

  # select the alternate at Bluesim link time (FlagsDecode.hs:1653)
  link_objects_pass {mkGroupHierTb mkOuterImpl mkOuterAlt} mkGroupHierTb "-use-impl mkOuterImpl=alt"
  sim_output mkGroupHierTb
  # (frozen: verified against a live run)
  find_regexp mkGroupHierTb.out {^first=43$}
}

if {$vtest == 1} {
  link_verilog_pass {mkGroupHierTb.v mkOuterImpl.v mkOuterAlt.v} mkGroupHierTb
  sim_verilog mkGroupHierTb
  # (frozen: verified against a live run)
  find_regexp mkGroupHierTb.out {^first=42$}

  # select the alternate with the module-wide macro
  # BSV_IMPL_<rootModule>_<key> (AVerilogUtil.hs:1035); bsc's -D is
  # forwarded to the Verilog link (bsc_build_vsim_*)
  # (frozen: verified against a live run)
  link_verilog_pass {mkGroupHierTb.v mkOuterImpl.v mkOuterAlt.v} mkGroupHierTb "-D BSV_IMPL_mkOuterImpl_alt"
  sim_verilog mkGroupHierTb
  find_regexp mkGroupHierTb.out {^first=43$}
}

# ----------
# 4. Negatives: malformed paths get the positioned MethodPath grammar
# error; vector-index syntax is rejected with the same message.
# The check runs at the member's codegen, hence -verilog.
# (frozen: verified against a live run)
# single tokens so s2par wrapping cannot split them; the position line
# format is `Error: "<file>", line N, column C: (S0015)')

compile_fail BadPathDoubleDot.bsv {-verilog}
find_regexp [make_bsc_output_name BadPathDoubleDot.bsv] {MethodPath}
find_regexp [make_bsc_output_name BadPathDoubleDot.bsv] {`fifo\.\.get'}
find_regexp [make_bsc_output_name BadPathDoubleDot.bsv] {"BadPathDoubleDot\.bsv", line}

compile_fail BadPathTrailingDot.bsv {-verilog}
find_regexp [make_bsc_output_name BadPathTrailingDot.bsv] {MethodPath}
find_regexp [make_bsc_output_name BadPathTrailingDot.bsv] {`fifo\.'}

compile_fail BadPathLeadingDot.bsv {-verilog}
find_regexp [make_bsc_output_name BadPathLeadingDot.bsv] {MethodPath}
find_regexp [make_bsc_output_name BadPathLeadingDot.bsv] {`\.get'}

compile_fail BadPathEmpty.bsv {-verilog}
find_regexp [make_bsc_output_name BadPathEmpty.bsv] {MethodPath}

compile_fail BadPathVectorIndex.bsv {-verilog}
find_regexp [make_bsc_output_name BadPathVectorIndex.bsv] {MethodPath}
find_regexp [make_bsc_output_name BadPathVectorIndex.bsv] {`fifo\[0\]\.get'}
find_regexp [make_bsc_output_name BadPathVectorIndex.bsv] {"BadPathVectorIndex\.bsv", line}
