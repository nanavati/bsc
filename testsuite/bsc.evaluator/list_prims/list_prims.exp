# Tests for list primitive implicit condition propagation and correctness.

# --- Compile-fail: conditions must NOT be dropped by list primitives ---
# One rule per primitive, each with (* no_implicit_conditions *).
# If any primitive drops the condition, the error count decreases.

compile_verilog_fail_error ImplCondListFail.bsv G0005 12

# --- Compile-fail: conditions through list<->array conversions ---
# Tests that conditions survive primListToArray / primArrayToList round-trips
# and cross-primitive chains (list→array→arrayMap, array→list→listFoldL, etc.)

compile_verilog_fail_error ImplCondConvertFail.bsv G0005 15

# --- Simulation tests: list primitive implicit condition equivalence ---
# sort_output=1 because rule scheduling order is non-deterministic.

# Per-element condition propagation through primListMap
test_c_veri_bsv ImplCondMapList "" "" "" 1
# Reference: recursive Cons/Nil pattern matching
test_c_veri_bsv ImplCondMapListRef "sysImplCondMapList.out.expected" "" "" 1
# Reference: list->array->map->list via primListToArray/primArrayMap/primArrayToList
test_c_veri_bsv ImplCondMapListArr "sysImplCondMapList.out.expected" "" "" 1

# Conjunction propagation through primListFoldL/R, any/all/elem via map+fold
test_c_veri_bsv ImplCondFoldList "" "" "" 1
# Reference: recursive Cons/Nil pattern matching
test_c_veri_bsv ImplCondFoldListRef "sysImplCondFoldList.out.expected" "" "" 1
# Reference: list->array->fold via primListToArray/primArrayFoldL/R
test_c_veri_bsv ImplCondFoldListArr "sysImplCondFoldList.out.expected" "" "" 1

# Per-element condition propagation through primListZipWith (two sources)
test_c_veri_bsv ImplCondZipList "" "" "" 1
# Reference: recursive head/tail zipWith
test_c_veri_bsv ImplCondZipListRef "sysImplCondZipList.out.expected" "" "" 1
# Reference: list->array->zipWith->list via primArrayZipWith
test_c_veri_bsv ImplCondZipListArr "sysImplCondZipList.out.expected" "" "" 1

# --- Basic correctness: select and length ---
test_c_veri_bsv ListSelectTest
