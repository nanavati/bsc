compile_verilog_pass ClockListNIfc.bsv
compare_verilog mkClockListNPassThrough.v

compile_verilog_pass ClockVectorIfcGate.bsv
compare_verilog mkClockVectorPassThrough.v

compile_verilog_pass SizeZero.bsv

# We substitute _ for vector indices in the string types passed to WrapField in GenWrap.hs
# to ensure that theinstance dictionaries can be combined for vector-blasted interfaces.
# This relies on the -dtypecheck dump from wrapper compilation
# overwriting the original -dtypecheck dump.
#
# Run both type-sharing configurations, naming each explicitly rather
# than leaning on whichever is the default.  With the ground-dictionary
# pool off, the combined dictionary shows up as the constraint below
# (2 copies -- one per remaining distinct instance, not one per blasted
# vector element, which is the property being tested).  With the pool
# on, those ground dictionaries are hoisted to top-level lifted
# definitions during typechecking, so the constraint does not appear in
# the dump at all: 0 copies asserts that the pool absorbed them, and
# would go non-zero if it stopped.
# nodeps (the 1) drops the -u that bsc_compile adds: with -u the second
# compile finds the .bo current, skips, and leaves the first pass's dump
# in place -- so the second assertion would silently re-check the first
# pass's output.
compile_backend_pass WrapFieldRepeat.bs \
    "-share-types-no-pool -dwrapper_typecheck=tcwrapper.out" 1
find_n_strings tcwrapper.out "Prelude.Bits Prelude.Bool 1" 2

compile_backend_pass WrapFieldRepeat.bs \
    "-share-types -dwrapper_typecheck=tcwrapper.out" 1
find_n_strings tcwrapper.out "Prelude.Bits Prelude.Bool 1" 0
