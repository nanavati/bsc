
# Under verilator these outputs differ for two deterministic reasons, so the
# affected comparisons use veribug "verilator" (XFAIL under verilator, normal
# under iverilog):
#  1. Verilator defers $finish to the end of the current eval (VL_FINISH_MT just
#     sets a flag; execution falls through), so a rule sharing the negedge block
#     with the $finish fires one extra time -> one extra $fwrite line in the .dat.
#  2. Verilator allocates MCD $fopen channels top-down (first handle 0x40000000
#     = 1<<30) vs the IEEE/iverilog bottom-up allocation (0x00000002).
if { $vtest } {
    test_veri_only_bsv FOpen
    check_verilog_output FOpen.dat.out FOpen.dat.out.expected verilator
}
if { $ctest } {
    test_c_only_bsv FOpen
    compare_file FOpen.dat.out 
}

if { $vtest } {
    test_veri_only_bsv FOpen2
    compare_file FOpen2.dat.out 
}

if { $ctest } {
    test_c_only_bsv FOpen2
    compare_file FOpen2.dat.out 
}

## 
