flag no-git
  description: Build without Git version metadata (Make: NOGIT=1).
  default: False
  manual: True

flag no-update-build-version
  description: Preserve an existing generated version (Make: NOUPDATEBUILDVERSION=1).
  default: False
  manual: True

flag stp-stub
  description: Build the vendored STP stub (Make: STP_STUB=1).
  default: False
  manual: True

flag yices-stub
  description: Build the vendored Yices stub (Make: YICES_STUB=1).
  default: False
  manual: True

custom-setup
  setup-depends:
    base        >=4.18.3.0,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    directory   >=1.3.8.5,
    filepath    >=1.4.301.0,
    process     >=1.6.19.0,

library
  if impl(ghc >= 9.0)
    build-depends: ghc-bignum
  if impl(ghc >= 9.10)
    build-depends: ghc-internal
  build-depends:
    array        >=0.5.8.0,
    base         >=4.18.3.0,
    bytestring   >=0.11.5.4,
    containers   >=0.6.7,
    deepseq      >=1.4.8.1,
    directory    >=1.3.8.5,
    filepath     >=1.4.301.0,
    integer-gmp  >=1.1,
    mtl          >=2.3.1,
    old-locale   ^>=1.0.0.7,
    old-time     ^>=1.1.1.0,
    process      >=1.6.19.0,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2,
    time         >=1.12.2,
    unix         >=2.8.6.0,
  default-language: GHC2021
  if impl(ghc >= 9.14.1)
    ghc-options: -fobject-determinism
  default-extensions:
    BangPatterns,
    FlexibleContexts,
    FlexibleInstances,
    TypeSynonymInstances,
  if os(osx)
    extra-libraries: c++
  else
    extra-libraries: stdc++
  ghc-options: -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
