common common_exes
  build-depends:
    base >=4.18.3.0,
    bsc,
  default-language: GHC2021
  if impl(ghc >= 9.14.1)
    ghc-options: -fobject-determinism
  ghc-options: -rtsopts "-with-rtsopts=-H256m -K10m -i1"
  hs-source-dirs: src/comp/app
  other-modules: Warmup
  autogen-modules: Warmup

executable bsc
  import: common_exes
  build-depends:
    containers >=0.6.7,
    directory  >=1.3.8.5,
    filepath   >=1.4.301.0,
    mtl        >=2.3.1,
    old-time   ^>=1.1.1.0,
    process    >=1.6.19.0,
